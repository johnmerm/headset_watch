{
  "manifest_version": 3,
  "name": "JBL D-Bus Teams Mute Bridge",
  "version": "1.2",
  "description": "Bridges physical headset buttons into Microsoft Teams cloud interface contexts.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "action": {
    "default_title": "JBL Teams Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.cloud.microsoft/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}